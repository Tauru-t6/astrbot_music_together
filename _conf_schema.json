{
  "enabled": {"type": "bool", "default": true, "description": "Enable the listening companion"},
  "server_url": {"type": "text", "default": "", "description": "Music Together server URL"},
  "identity_secret": {"type": "text", "default": "", "description": "HMAC secret configured by the Music Together server"},
  "room_id": {"type": "text", "default": "", "description": "Room ID; empty joins the first room or creates one"},
  "nickname": {"type": "text", "default": "小听", "description": "Nickname used in the music room"},
  "create_if_missing": {"type": "bool", "default": true, "description": "Create a room when no room is available"},
  "gemini_endpoint": {"type": "text", "default": "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent", "description": "Gemini-compatible endpoint; {model} is replaced"},
  "gemini_key": {"type": "text", "default": "", "description": "Gemini API key"},
  "gemini_model": {"type": "text", "default": "gemini-2.5-flash", "description": "Gemini model name"},
  "proxy": {"type": "text", "default": "", "description": "Optional HTTP proxy"},
  "max_reactions": {"type": "int", "default": 4, "description": "Maximum reactions in knowledge-only mode"},
  "segment_seconds": {"type": "int", "default": 45, "description": "Audio analysis segment length"},
  "analyze_lead_seconds": {"type": "int", "default": 20, "description": "Analyze before each segment"},
  "persona": {"type": "text", "default": "你叫小听。语气简短、口语化，像和用户一起听歌时随口点评。不要编造听不到的内容。", "description": "Persona prompt"},
  "astrbot_chat_url": {"type": "text", "default": "http://127.0.0.1:6185/api/v1/chat", "description": "Optional AstrBot chat API URL"},
  "astrbot_api_key": {"type": "text", "default": "", "description": "Optional AstrBot API bearer token"},
  "astrbot_session": {"type": "text", "default": "music-bot", "description": "AstrBot session ID"},
  "astrbot_username": {"type": "text", "default": "music-bot", "description": "AstrBot API username"},
  "astrbot_provider": {"type": "text", "default": "", "description": "Optional AstrBot provider name"},
  "reply_all_chat": {"type": "bool", "default": true, "description": "Reply to every non-system room message"}
}
